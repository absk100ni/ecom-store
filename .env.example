# Google Sign-In Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Store display name (page titles, payment modals, legal refs; default: LucubraElec)
VITE_STORE_NAME=LucubraElec

# Phone OTP login toggle (false/unset = Google-only login for production)
VITE_ENABLE_PHONE_LOGIN=false

# API URL (defaults to /api/v1 which proxies to localhost:8080 in dev)
VITE_API_URL=

# Social channels (shown in home-page Follow Us section + footer; empty = hidden)
VITE_INSTAGRAM_URL=https://instagram.com/yourhandle
VITE_INSTAGRAM_HANDLE=@yourhandle
VITE_YOUTUBE_URL=https://youtube.com/@yourchannel
VITE_YOUTUBE_HANDLE=YourChannel
VITE_FACEBOOK_URL=https://facebook.com/yourpage
VITE_FACEBOOK_HANDLE=YourPage

# Analytics — leave empty to disable that tracker (silent no-op)
VITE_META_PIXEL_ID=
VITE_GA4_MEASUREMENT_ID=

# Sentry error reporting (sentry.io project DSN; leave blank to disable)
# Free tier: 5k events/mo shared across all apps — quota-capped client-side
VITE_SENTRY_DSN=

# Business / Legal (India E-Commerce Rules 2020)
VITE_BUSINESS_LEGAL_NAME=LucubraElec India Private Limited
VITE_BUSINESS_ADDRESS=123 MG Road, Bengaluru, Karnataka 560001, India
VITE_SUPPORT_EMAIL=support@lucubraelec.in
VITE_SUPPORT_PHONE=+91-9876543210
VITE_BUSINESS_GSTIN=29ABCDE1234F1Z5

# Grievance Officer (mandatory under Consumer Protection E-Commerce Rules 2020)
VITE_GRIEVANCE_OFFICER_NAME=Grievance Officer
VITE_GRIEVANCE_OFFICER_EMAIL=grievance@lucubraelec.in
VITE_GRIEVANCE_OFFICER_PHONE=+91-9876543211

# Return policy display (days from delivery; actual enforcement is backend)
VITE_RETURN_WINDOW_DAYS=7
